{
  "name": "WorkoutAssignment",
  "type": "object",
  "properties": {
    "workout_id": {
      "type": "string"
    },
    "workout_title": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "athlete_id": {
      "type": "string"
    },
    "coach_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "completion_count": {
      "type": "number",
      "default": 0
    },
    "source_workout_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "completed",
        "skipped"
      ],
      "default": "planned"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "workout_id",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.athlete_id": "{{user.id}}"
        },
        {
          "data.coach_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.coach_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
