{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "coach",
        "athlete"
      ],
      "default": "athlete",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "sport": {
      "type": "string"
    },
    "coach_id": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "bio": {
      "type": "string"
    },
    "profile_image_url": {
      "type": "string"
    },
    "onboarded": {
      "type": "boolean",
      "default": false,
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "coach_type": {
      "type": "string",
      "enum": [
        "head_coach",
        "assistant_coach",
        "strength_conditioning",
        "physio",
        "other"
      ]
    },
    "position": {
      "type": "string"
    },
    "age_group": {
      "type": "string",
      "description": "Squad age category, e.g. U17, U19, Senior"
    }
  }
}
