{
  "name": "CollaborationMessage",
  "type": "object",
  "properties": {
    "athlete_id": {
      "type": "string"
    },
    "coach_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "athlete",
        "coach"
      ]
    },
    "content": {
      "type": "string"
    },
    "attachment_url": {
      "type": "string"
    }
  },
  "required": [
    "athlete_id",
    "sender_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.athlete_id": "{{user.id}}"
        },
        {
          "data.coach_id": "{{user.id}}"
        },
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.athlete_id": "{{user.id}}"
        },
        {
          "data.coach_id": "{{user.id}}"
        },
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}