{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "Coach user id (individual plans) or club admin id"
    },
    "plan": {
      "type": "string",
      "enum": [
        "trial",
        "individual_coach",
        "club",
        "multi_team_club"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "trialing",
        "active",
        "past_due",
        "canceled",
        "expired"
      ]
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "type": "string",
      "description": "Payment provider name once configured"
    },
    "provider_customer_id": {
      "type": "string"
    },
    "provider_subscription_id": {
      "type": "string"
    },
    "last_event_id": {
      "type": "string",
      "description": "Last processed webhook event id (idempotency)"
    }
  },
  "required": [
    "owner_id",
    "plan",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
