{
  "name": "ClearanceMilestone",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "coach_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "locked",
        "in_progress",
        "completed"
      ],
      "default": "locked"
    },
    "required_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cleared_by_name": {
      "type": "string",
      "description": "Professional who recorded the clearance decision"
    },
    "clearance_note": {
      "type": "string"
    },
    "cleared_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_by_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "title",
    "order"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
