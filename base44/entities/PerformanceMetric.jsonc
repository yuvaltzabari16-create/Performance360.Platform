{
  "name": "PerformanceMetric",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "coach_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "type": "string",
      "enum": [
        "speed",
        "power",
        "strength",
        "change_of_direction",
        "endurance",
        "repeated_sprint",
        "mobility"
      ]
    },
    "test_name": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "metric_key": {
      "type": "string",
      "description": "Key from base44/shared/metrics.ts catalog"
    },
    "side": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "bilateral"
      ]
    },
    "notes": {
      "type": "string"
    },
    "recorded_by_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "athlete",
        "coach",
        "admin"
      ]
    }
  },
  "required": [
    "user_id",
    "date",
    "category",
    "test_name",
    "value"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
