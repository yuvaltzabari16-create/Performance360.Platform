# Supabase project (Project Settings → API). The publishable/anon key is safe in the browser;
# all access is enforced by row level security in the database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Public base URL used for invitation links and auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Security and compliance (all optional) ---
# Bot protection: Cloudflare Turnstile. When both are set, public forms require the challenge.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Secret used to sign the form time-trap token (defaults to the Supabase key).
# BOT_GUARD_SECRET=
# Rate limits per IP per minute (sign-in/sign-up, other writes, reads).
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_WRITE_MAX=180
# RATE_LIMIT_READ_MAX=600
# Test runs only: turn limits off / allow instant form submits.
# RATE_LIMIT_DISABLED=1
# BOT_GUARD_MIN_MS=0

# Operator details shown on /privacy and /terms (fill in before launch). LEGAL_REVIEWED=1 removes the
# "draft pending legal review" notice: set it only after a lawyer has approved the texts.
# OPERATOR_NAME=
# OPERATOR_ADDRESS=
# OPERATOR_EMAIL=
# PRIVACY_EMAIL=
# LEGAL_REVIEWED=1

# Accessibility statement contact (shown on /accessibility; fill in before launch).
# ACCESSIBILITY_COORDINATOR=
# ACCESSIBILITY_EMAIL=
# ACCESSIBILITY_PHONE=

# Hosted checkout only: no card data ever touches this app.
# PAYMENT_PLANS=[{"id":"pro","name":"Pro","description":"For coaches","checkoutUrl":"https://pay.example.com/c/abc"}]
# PAYMENT_ALLOWED_HOSTS=pay.example.com

# Hosts treated as affiliate links (disclosed automatically), comma separated.
# AFFILIATE_DOMAINS=

# Scheduled email job (optional). Vercel Cron (vercel.json) or the Netlify scheduled function calls
# /api/cron/notification-emails once a day and sends CRON_SECRET as a bearer token. The service-role key
# (Supabase -> Project settings -> API) lets the job read what is due through service-only database functions.
# Keep both secret; never expose them to the browser.
# CRON_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=

# Email copies of notifications (optional). Resend: https://resend.com. MAIL_FROM must be a verified sender,
# for example "Performance360 <no-reply@yourdomain.com>". Needs CRON_SECRET and SUPABASE_SERVICE_ROLE_KEY above.
# RESEND_API_KEY=
# MAIL_FROM=

# Sign in with an email code (see docs/DEPLOYMENT.md, section 2b). 1 shows the form after the Supabase email templates carry {{ .Token }}.
# NEXT_PUBLIC_EMAIL_CODE_LOGIN=1
# Optional: Google sign-in. 1 shows the button after the provider is set up in Supabase.
# NEXT_PUBLIC_GOOGLE_LOGIN=1
# 0 hides the email and password form so Google is the only way in.
# NEXT_PUBLIC_PASSWORD_LOGIN=0

# Team subscriptions (see docs/DEPLOYMENT.md, section 2c).
# BILLING_REQUIRED=1
# STRIPE_WEBHOOK_SECRET=whsec_...
# BILLING_PORTAL_URL=https://billing.stripe.com/p/login/...
